@{ ViewBag.Title = "Xác thực email"; }

<div class="box otp-box">
    <h4>Xác thực email</h4>
    <p class="text-muted">Mã xác thực 6 số đã được gửi đến <b>@ViewBag.Email</b> (kiểm tra cả mục Spam). Mã có hiệu lực 10 phút.</p>
    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

    @using (Html.BeginForm("VerifyEmail", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <label class="form-label">Mã xác thực</label>
        <input type="text" name="code" class="form-control otp-input" maxlength="6"
               inputmode="numeric" autocomplete="one-time-code" placeholder="••••••" required autofocus />
        <button type="submit" class="btn btn-brand w-100 mt-3">Xác nhận</button>
    }

    @using (Html.BeginForm("ResendRegisterCode", "Account", FormMethod.Post, new { @class = "text-center mt-3" }))
    {
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-link">Gửi lại mã</button>
        <a class="btn btn-link" href="@Url.Action("Register")">Đổi email</a>
    }
</div>
