@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-card">
    <h1 class="auth-title">Đăng nhập</h1>
    <p class="auth-sub">Chào mừng bạn quay lại @CauHinh.Get("TenCuaHang", "PhoneStore")</p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @using (Html.BeginForm("Login", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

        <div class="mb-3">
            <label for="email" class="form-label">Email hoặc số điện thoại</label>
            <input type="text" id="email" name="email" class="form-control" placeholder="Nhập email hoặc số điện thoại..." value="@(Request["email"])" required />
        </div>

        <div class="mb-2">
            <label for="matKhau" class="form-label">Mật khẩu</label>
            <input type="password" id="matKhau" name="matKhau" class="form-control" placeholder="Nhập mật khẩu..." required />
        </div>

        <div class="text-end mb-3">
            <a href="@Url.Action("ForgotPassword", "Account")" class="small">Quên mật khẩu?</a>
        </div>

        <button type="submit" class="btn btn-brand w-100 py-2">ĐĂNG NHẬP</button>
    }

    @Html.Partial("_SocialLogin")

    <div class="auth-foot">
        Chưa có tài khoản? <a href="@Url.Action("Register", "Account", new { returnUrl = ViewBag.ReturnUrl })" class="fw-bold">Đăng ký ngay</a>
    </div>
</div>