@{ ViewBag.Title = "Đặt lại mật khẩu"; }

<div class="box otp-box">
    <h4>Đặt lại mật khẩu</h4>
    <p class="text-muted">Nếu <b>@ViewBag.Email</b> có tài khoản, mã 6 số đã được gửi đến hộp thư (kiểm tra cả mục Spam).</p>
    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

    @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <label class="form-label">Mã xác thực</label>
        <input type="text" name="code" class="form-control otp-input" maxlength="6"
               inputmode="numeric" autocomplete="one-time-code" placeholder="••••••" required autofocus />
        <label class="form-label mt-3">Mật khẩu mới</label>
        <input type="password" name="matKhauMoi" class="form-control" minlength="6" required />
        <label class="form-label mt-3">Nhập lại mật khẩu mới</label>
        <input type="password" name="xacNhan" class="form-control" minlength="6" required />
        <button type="submit" class="btn btn-brand w-100 mt-3">Đổi mật khẩu</button>
    }

    @using (Html.BeginForm("ResendResetCode", "Account", FormMethod.Post, new { @class = "text-center mt-3" }))
    {
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-link">Gửi lại mã</button>
        <a class="btn btn-link" href="@Url.Action("ForgotPassword")">Đổi email</a>
    }
</div>