@{ ViewBag.Title = "Đặt mật khẩu mới"; }

<div class="box otp-box">
    <h4>Đặt mật khẩu mới</h4>
    <p class="text-muted">Xác thực thành công. Nhập mật khẩu mới cho <b>@ViewBag.Email</b>.</p>
    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

    @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <label class="form-label">Mật khẩu mới</label>
        <input type="password" name="matKhauMoi" class="form-control"
               minlength="6" autocomplete="new-password" required autofocus />
        <label class="form-label mt-3">Nhập lại mật khẩu mới</label>
        <input type="password" name="xacNhan" class="form-control"
               minlength="6" autocomplete="new-password" required />
        <button type="submit" class="btn btn-brand w-100 mt-3">Đổi mật khẩu</button>
    }
</div>