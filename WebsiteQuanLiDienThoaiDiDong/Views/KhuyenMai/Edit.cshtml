@model WebsiteQuanLiDienThoaiDiDong.Models.KhuyenMai

@{
    ViewBag.Title = "Sửa khuyến mãi";
}

<div class="container km-page">
    <div class="km-form-card p-4 p-md-5">

        <div class="mb-4">
            <h2 class="km-title">Sửa khuyến mãi</h2>
            <p class="text-muted mb-0">Cập nhật thông tin voucher</p>
        </div>

        @using (Html.BeginForm("Edit", "KhuyenMai", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)
            @*@Html.ValidationSummary(false, "", new { @class = "alert" })*@
            //ValidationMessageFor
            <hr />

            <div class="row g-3">

                <div class="col-md-6">
                    @Html.LabelFor(m => m.MaCode, "Mã voucher", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.MaCode, new
                    {
                        @class = "form-control",
                        maxlength = "30",
                        style = "text-transform:uppercase"
                    })
                    @Html.ValidationMessageFor(m => m.MaCode)
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.TenKhuyenMai, "Tên khuyến mãi", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.TenKhuyenMai, new
                    {
                        @class = "form-control",
                        maxlength = "150"
                    })
                    @Html.ValidationMessageFor(m => m.TenKhuyenMai)
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.LoaiGiam, "Loại giảm", new { @class = "form-label" })
                    @Html.DropDownListFor(m => m.LoaiGiam,
                        new SelectList(new[]
                        {
                            new { Value = "PHANTRAM", Text = "Giảm theo phần trăm" },
                            new { Value = "SOTIEN", Text = "Giảm số tiền cố định" }
                        }, "Value", "Text", Model.LoaiGiam),
                        new { @class = "form-select", id = "LoaiGiam" })
                    @Html.ValidationMessageFor(m => m.LoaiGiam)
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.GiaTriGiam, "Giá trị giảm", new { @class = "form-label" })
                    @Html.TextBox("GiaTriGiam", Model.GiaTriGiam.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture),
                        new
                        {
                            @class = "form-control",
                            type = "number",
                            min = "0.01",
                            step = "0.01"
                        })
                    @Html.ValidationMessageFor(m => m.GiaTriGiam)
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.GiamToiDa, "Giảm tối đa (đ)", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.GiamToiDa, new
                    {
                        @class = "form-control",
                        type = "number",
                        min = "1",
                        step = "1",
                        placeholder = "Để trống nếu không giới hạn",
                        id = "GiamToiDa"
                    })
                    @Html.ValidationMessageFor(m => m.GiamToiDa)
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.GiamToiDa, "Giảm tối đa (đ)", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.GiamToiDa, new
                    {
                        @class = "form-control",
                        type = "number",
                        min = "1",
                        step = "1",
                        placeholder = "Để trống nếu không giới hạn"
                    })
                    @Html.ValidationMessageFor(m => m.GiamToiDa)
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.DonToiThieu, "Giá trị đơn tối thiểu (đ)", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.DonToiThieu, new
                    {
                        @class = "form-control",
                        type = "number",
                        min = "0",
                        step = "1"
                    })
                    @Html.ValidationMessageFor(m => m.DonToiThieu)
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.NgayBatDau, "Ngày bắt đầu", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.NgayBatDau, "{0:yyyy-MM-ddTHH:mm}",
                        new { @class = "form-control", type = "datetime-local" })
                    @Html.ValidationMessageFor(m => m.NgayBatDau)
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.NgayKetThuc, "Ngày kết thúc", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.NgayKetThuc, "{0:yyyy-MM-ddTHH:mm}",
                        new { @class = "form-control", type = "datetime-local" })
                    @Html.ValidationMessageFor(m => m.NgayKetThuc)
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.SoLuong, "Số lượng khuyến mãi", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.SoLuong, new
                     {
                         @class = "form-control",
                         type = "number",
                         min = Model.DaDung,
                         placeholder = "Để trống nếu không giới hạn"
                     })
                    @Html.ValidationMessageFor(m => m.SoLuong)
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.GioiHanMoiNguoi, "Giới hạn mỗi người", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.GioiHanMoiNguoi, new
                    {
                        @class = "form-control",
                        type = "number",
                        min = "1",
                        step = "1",
                        placeholder = "Để trống nếu không giới hạn"
                    })
                    @Html.ValidationMessageFor(m => m.GioiHanMoiNguoi)
                </div>

                <div class="col-12">
                    <div class="form-check form-switch">
                        @Html.CheckBoxFor(m => m.TrangThai,
                            new { @class = "form-check-input", role = "switch" })
                        @Html.LabelFor(m => m.TrangThai, "Kích hoạt khuyến mãi",
                            new { @class = "form-check-label" })
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a href="@Url.Action("Index", "KhuyenMai")"
                   class="btn btn-outline-secondary">
                    Quay lại
                </a>
                <button type="submit" class="btn km-btn">
                    <i class="bi bi-check-lg"></i> Lưu thay đổi
                </button>
            </div>
        }
    </div>
</div>

<script>
    function xuLyLoaiGiam() {
        var loaiGiam = document.getElementById("LoaiGiam");
        var giamToiDa = document.getElementById("GiamToiDa");

        if (loaiGiam.value === "SOTIEN") {
            giamToiDa.value = "";
            giamToiDa.disabled = true;
        } else {
            giamToiDa.disabled = false;
        }
    }

    document.getElementById("LoaiGiam").addEventListener("change", xuLyLoaiGiam);

    xuLyLoaiGiam();
</script>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

