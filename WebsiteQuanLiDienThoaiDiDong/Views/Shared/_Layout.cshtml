<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - @CauHinh.Get("TenCuaHang", "PhoneStore")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/Content/site.css" rel="stylesheet" />
</head>
<body>
    <div class="promo-strip">
        <div class="container">
            <span><i class="bi bi-truck"></i>Giao nhanh toàn quốc</span>
            <span><i class="bi bi-credit-card"></i>Trả góp 0%</span>
            <span><i class="bi bi-qr-code"></i>Thanh toán bằng mã QR</span>
            <span><i class="bi bi-telephone"></i>Hotline @CauHinh.Get("Hotline")</span>
        </div>
    </div>

    <header class="site-header">
        <div class="container hd">
            <a class="logo" href="@Url.Action("Index", "Home", new { area = "" })"><i class="bi bi-phone"></i> @CauHinh.Get("TenCuaHang", "PhoneStore")</a>

            <div class="cat-drop">
                <button type="button" class="cat-btn" id="catBtn"><i class="bi bi-list"></i> Danh mục</button>
                <div class="cat-panel">@Html.Action("Menu", "Home", new { area = "" })</div>
            </div>

            <form class="search" method="get" action="@Url.Action("Index", "SanPham", new { area = "" })">
                <input type="text" name="tuKhoa" placeholder="Bạn muốn tìm điện thoại nào?" autocomplete="off" />
                <button type="submit" aria-label="Tìm kiếm"><i class="bi bi-search"></i></button>
            </form>

            <div class="hd-right">
                <a class="hd-link" href="@Url.Action("TraCuu", "BaoHanh", new { area = "" })">
                    <i class="bi bi-shield-check"></i><span>Tra cứu<br />bảo hành</span>
                </a>

                @if (AuthHelper.IsLoggedIn)
                {
                    <div class="dropdown">
                        <a class="hd-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle"></i><span>@AuthHelper.HoTen</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item account-favorite-link" href="@Url.Action("YeuThich", "SanPham", new { area = "" })"><i class="bi bi-heart-fill"></i><span>Yêu thích</span></a></li>
                            @if (AuthHelper.IsStaff)
                            {
                                <li><a class="dropdown-item" href="@Url.Action("Index", "ThongKe", new { area = "Admin" })">Trang quản trị</a></li>
                            }
                            <li><a class="dropdown-item" href="@Url.Action("Index", "DonHang", new { area = "" })">Đơn hàng của tôi</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("DangXuat", "TaiKhoan", new { area = "" })">Đăng xuất</a></li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="hd-link" href="@Url.Action("DangNhap", "TaiKhoan", new { area = "" })">
                        <i class="bi bi-person-circle"></i><span>Đăng nhập<br />Đăng ký</span>
                    </a>
                }

                <a class="hd-link" href="@Url.Action("Index", "GioHang", new { area = "" })">
                    <i class="bi bi-cart3"></i>@Html.Action("Badge", "GioHang", new { area = "" })<span>Giỏ hàng</span>
                </a>
            </div>
        </div>
    </header>

    <main class="container pt-3">
        @if (TempData["Msg"] != null)
        {<div class="alert alert-success">@TempData["Msg"]</div>}
        @if (TempData["Err"] != null)
        {<div class="alert alert-danger">@TempData["Err"]</div>}
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h6>@CauHinh.Get("TenCuaHang", "PhoneStore")</h6>
                    <div>Điện thoại và phụ kiện chính hãng.</div>
                    <div>Hotline: <strong class="text-dark">@CauHinh.Get("Hotline")</strong></div>
                </div>
                <div class="col-6 col-md-2">
                    <h6>Hỗ trợ</h6>
                    <a href="@Url.Action("TraCuu", "BaoHanh", new { area = "" })">Tra cứu bảo hành</a>
                    <a href="@Url.Action("Index", "DonHang", new { area = "" })">Đơn hàng của tôi</a>
                    <a href="@Url.Action("Index", "GioHang", new { area = "" })">Giỏ hàng</a>
                </div>
                <div class="col-6 col-md-3">
                    <h6>Thanh toán</h6>
                    <div>Khi nhận hàng (COD)</div>
                    <div>Chuyển khoản QR (VietQR)</div>
                    <div>Trả góp 0%</div>
                </div>
                <div class="col-md-3">
                    <h6>Tài khoản</h6>
                    <a href="@Url.Action("DangNhap", "TaiKhoan", new { area = "" })">Đăng nhập</a>
                    <a href="@Url.Action("DangKy", "TaiKhoan", new { area = "" })">Đăng ký</a>
                </div>
            </div>
            <div class="foot-bottom">&copy; @DateTime.Now.Year @CauHinh.Get("TenCuaHang", "PhoneStore") - Đồ án môn Lập trình Web ASP.NET</div>
        </div>
    </footer>

    <div class="toast-container position-fixed top-0 end-0 p-3" id="toastBox" style="z-index:2000"></div>

    @Scripts.Render("~/bundles/jquery")
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // bấm nút "Danh mục" để mở/đóng (dùng cho điện thoại; trên máy tính menu mở khi rê chuột)
        $('#catBtn').on('click', function (e) { e.stopPropagation(); $('.cat-drop').toggleClass('open'); });
        $(document).on('click', function () { $('.cat-drop').removeClass('open'); });

        function showToast(msg, ok) {
            var el = $('<div class="toast align-items-center border-0 text-bg-' + (ok ? 'success' : 'danger') + '"><div class="d-flex"><div class="toast-body"></div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div></div>');
            el.find('.toast-body').text(msg);
            $('#toastBox').append(el);
            new bootstrap.Toast(el[0], { delay: 2500 }).show();
        }
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
