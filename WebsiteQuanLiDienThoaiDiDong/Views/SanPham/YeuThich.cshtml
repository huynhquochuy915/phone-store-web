@model List<WebsiteQuanLiDienThoaiDiDong.Models.ViewModels.SanPhamCardVM>
@{ ViewBag.Title = "Sản phẩm yêu thích"; }

<main data-favorite-page="true">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0"><i class="bi bi-heart-fill text-danger"></i> Sản phẩm yêu thích</h1>
        <a class="btn btn-outline-secondary" href="@Url.Action("Index")">Tiếp tục mua sắm</a>
    </div>
    @if (!Model.Any())
    {
        <div class="alert alert-light border text-center py-5">
            <p class="h5">Bạn chưa lưu sản phẩm yêu thích nào.</p>
            <a class="btn btn-danger mt-2" href="@Url.Action("Index")">Xem sản phẩm</a>
        </div>
    }
    else
    {
        <div class="pgrid">@foreach (var sp in Model) { @Html.Partial("_SanPhamCard", sp) }</div>
    }
</main>
