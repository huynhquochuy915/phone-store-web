@model WebsiteQuanLiDienThoaiDiDong.Models.ViewModels.SoSanhVM
@{
    ViewBag.Title = "So sánh sản phẩm";
    var noImg = Url.Content("~/Content/images/no-image.png");
    Func<object, string> v = o => { var s = Convert.ToString(o); return string.IsNullOrWhiteSpace(s) ? "—" : s; };
}

<div class="cmp-page">
    <h1 class="h3 fw-bold mb-1">So sánh sản phẩm</h1>
    <p class="text-muted">Chọn 2 đến 3 điện thoại từ danh sách yêu thích của bạn.</p>

    @if (Model.YeuThichs.Count < 2)
    {
        <div class="history-empty">
            <i class="bi bi-heart"></i>
            <h2>Bạn cần ít nhất 2 điện thoại yêu thích</h2>
            <div>Bấm biểu tượng trái tim ở sản phẩm để thêm vào danh sách yêu thích.</div>
            <a href="@Url.Action("Index", "SanPham", new { loaiId = 1 })">Xem điện thoại</a>
        </div>
    }
    else
    {
        <form method="get" action="@Url.Action("SoSanh")" id="pickForm">
            <div class="pick-grid">
                @foreach (var sp in Model.YeuThichs)
                {
                    var anh = sp.HinhAnhSanPhams.OrderByDescending(x => x.LaAnhChinh).ThenBy(x => x.ThuTu).FirstOrDefault();
                    var daChon = Model.DaChon.Contains(sp.Id);
                    <label class="pick-item @(daChon ? "on" : "")">
                        <input type="checkbox" name="ids" value="@sp.Id" @(daChon ? "checked" : "") />
                        <img src="@(anh == null ? noImg : Url.Content("~" + anh.DuongDan))" alt="@sp.TenSanPham"
                             onerror="this.onerror=null;this.src='@noImg'" />
                        <span class="pick-name">@sp.TenSanPham</span>
                    </label>
                }
            </div>
            <div class="d-flex align-items-center gap-3 mt-3">
                <button type="submit" id="pickBtn" class="btn-dashboard" disabled>So sánh</button>
                <span class="text-muted small" id="pickHint"></span>
            </div>
        </form>

        if (Model.SanPhams.Count >= 2)
        {
            <div class="table-responsive mt-4">
                <table class="table cmp-table align-middle">
                    <thead>
                        <tr>
                            <th></th>
                            @foreach (var sp in Model.SanPhams)
                            {
                                var anh = sp.HinhAnhSanPhams.OrderByDescending(x => x.LaAnhChinh).ThenBy(x => x.ThuTu).FirstOrDefault();
                                <th>
                                    <a href="@Url.Action("ChiTiet", new { id = sp.Id })" class="cmp-col-head">
                                        <img src="@(anh == null ? noImg : Url.Content("~" + anh.DuongDan))" alt="@sp.TenSanPham"
                                             onerror="this.onerror=null;this.src='@noImg'" />
                                        <div class="cmp-col-brand">@sp.ThuongHieu.TenThuongHieu</div>
                                        <div class="cmp-col-name">@sp.TenSanPham</div>
                                    </a>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <th>Giá</th>
                            @foreach (var sp in Model.SanPhams)
                            {
                                var bt = sp.BienTheSanPhams.Where(x => x.HienThi).OrderBy(x => x.GiaBan).FirstOrDefault();
                                <td class="text-danger fw-bold">@(bt == null ? "Tạm ngừng bán" : bt.GiaBan.VND())</td>
                            }
                        </tr>
                        <tr><th>Màn hình</th>@foreach (var sp in Model.SanPhams)
                        {<td>@v(sp.ManHinh)</td>}</tr>
                        <tr><th>Chip xử lý</th>@foreach (var sp in Model.SanPhams)
                        {<td>@v(sp.ChipXuLy)</td>}</tr>
                        <tr><th>RAM</th>@foreach (var sp in Model.SanPhams)
                        {<td>@v(sp.RAM)</td>}</tr>
                        <tr><th>Camera sau</th>@foreach (var sp in Model.SanPhams)
                        {<td>@v(sp.CameraSau)</td>}</tr>
                        <tr><th>Pin</th>@foreach (var sp in Model.SanPhams)
                        {<td>@v(sp.Pin)</td>}</tr>
                        <tr><th>Bảo hành</th>@foreach (var sp in Model.SanPhams)
                        {<td>@sp.BaoHanhThang tháng</td>}</tr>
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@section scripts {
    <script>
        (function () {
            var boxes = $('#pickForm input[type=checkbox]'), btn = $('#pickBtn'), hint = $('#pickHint');
            function refresh() {
                var n = boxes.filter(':checked').length;
                boxes.each(function () { $(this).closest('.pick-item').toggleClass('on', this.checked); });
                boxes.not(':checked').prop('disabled', n >= 3);
                btn.prop('disabled', n < 2);
                hint.text('Đã chọn ' + n + '/3');
            }
            boxes.on('change', refresh);
            refresh();
        })();
    </script>
}