@model WebsiteQuanLiDienThoaiDiDong.Models.ViewModels.TrangChuVM
@{
    ViewBag.Title = "Trang chủ";
    var hangs = new[] { "Apple", "Samsung", "Xiaomi", "OPPO", "vivo" };
    var capSoSanh = Model.DienThoai.Take(2).ToList();
    var noImg2 = Url.Content("~/Content/images/no-image.png");
}

<section class="hero">
    <aside class="cat-side">@Html.Action("Menu", "Home", new { area = "" })</aside>

    <div id="heroCar" class="carousel slide hero-main" data-bs-ride="carousel" data-bs-interval="5000">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#heroCar" data-bs-slide-to="0" class="active" aria-label="Banner 1"></button>
            <button type="button" data-bs-target="#heroCar" data-bs-slide-to="1" aria-label="Banner 2"></button>
            <button type="button" data-bs-target="#heroCar" data-bs-slide-to="2" aria-label="Banner 3"></button>
        </div>
        <div class="carousel-inner">
            <div class="carousel-item active">
                <div class="slide slide-1">
                    <h2>Điện thoại chính hãng, trả góp 0%</h2>
                    <p>Chọn máy, chọn màu, nhận hàng nhanh. Thanh toán khi nhận hoặc quét mã QR.</p>
                    <a class="btn btn-light" href="@Url.Action("Index", "SanPham", new { area = "", loaiId = 1 })">Xem điện thoại</a>
                </div>
            </div>
            <div class="carousel-item">
                <div class="slide slide-2">
                    <h2>Phụ kiện mua kèm cho máy mới</h2>
                    <p>Sạc nhanh, cáp, pin dự phòng, ốp lưng và kính cường lực.</p>
                    <a class="btn btn-light" href="@Url.Action("Index", "SanPham", new { area = "", loaiId = 3 })">Chọn phụ kiện</a>
                </div>
            </div>
            <div class="carousel-item">
                <div class="slide slide-3">
                    <h2>Nhập CHAOBAN10 để giảm 10% đơn đầu tiên</h2>
                    <p>Giảm tối đa 500.000₫, áp dụng cho đơn từ 1.000.000₫.</p>
                    <a class="btn btn-dark" href="@Url.Action("Index", "SanPham", new { area = "" })">Mua sắm ngay</a>
                </div>
            </div>
        </div>
    </div>

    <aside class="hero-side">
        <a class="tile" href="@Url.Action("TraCuu", "BaoHanh", new { area = "" })">
            <i class="bi bi-upc-scan"></i>
            <strong>Tra cứu bảo hành</strong>
            <span>Nhập số IMEI để xem hạn bảo hành</span>
        </a>
        <a class="tile" href="@Url.Action("Index", "SanPham", new { area = "" })">
            <i class="bi bi-ticket-perforated"></i>
            <strong>Giảm 500.000₫</strong>
            <span>Đơn từ 15 triệu, nhập mã GIAM500K</span>
        </a>
    </aside>
</section>

<section class="policy">
    <div><i class="bi bi-patch-check"></i><span><b>Hàng chính hãng</b>Có bảo hành theo hãng</span></div>
    <div><i class="bi bi-truck"></i><span><b>Giao nhanh</b>Phí ship theo tỉnh thành</span></div>
    <div><i class="bi bi-credit-card-2-front"></i><span><b>Trả góp 0%</b>Kỳ hạn 3 đến 12 tháng</span></div>
    <div><i class="bi bi-qr-code-scan"></i><span><b>Thanh toán QR</b>Chuyển khoản VietQR</span></div>
</section>

@if (Model.NoiBat.Any())
{
    <section class="sec deal">
        <div class="deal-head">
            <h2><i class="bi bi-lightning-charge-fill"></i> NỔI BẬT HÔM NAY</h2>
            <div class="countdown"><span>Kết thúc sau</span><b id="cdDeal">--:--:--</b></div>
            <a href="@Url.Action("Index", "SanPham", new { area = "" })">Xem tất cả <i class="bi bi-chevron-right"></i></a>
        </div>
        <div class="hrow-wrap">
            <button type="button" class="hrow-nav prev" aria-label="Trước"><i class="bi bi-chevron-left"></i></button>
            <div class="hrow">
                @foreach (var sp in Model.NoiBat)
                {@Html.Partial("_SanPhamCard", sp)}
            </div>
            <button type="button" class="hrow-nav next" aria-label="Sau"><i class="bi bi-chevron-right"></i></button>
        </div>
    </section>
}

<section class="sec">
    <div class="sec-head">
        <h2>Bán chạy nhất</h2>
        <a href="@Url.Action("Index", "SanPham", new { area = "", sapXep = "banchay" })">Xem tất cả</a>
    </div>
    <div class="pgrid">
        @foreach (var sp in Model.BanChay)
        {@Html.Partial("_SanPhamCard", sp)}
    </div>
</section>

@if (Model.DienThoai.Any())
{
    <section class="sec">
        <div class="sec-head">
            <h2>Điện thoại</h2>
            <div class="sec-tabs">
                @foreach (var h in hangs)
                {<a href="@Url.Action("Index", "SanPham", new { area = "", loaiId = 1, tuKhoa = h })">@h</a>}
                <a class="all" href="@Url.Action("Index", "SanPham", new { area = "", loaiId = 1 })">Xem tất cả</a>
            </div>
        </div>
        <div class="pgrid">
            @foreach (var sp in Model.DienThoai)
            {@Html.Partial("_SanPhamCard", sp)}
        </div>
    </section>
}

@if (capSoSanh.Count == 2)
{
    <section class="cmp">
        <div class="cmp-left">
            <span class="cmp-eyebrow">SO SÁNH THÔNG MINH</span>
            <h2>Đặt cạnh nhau.<br />Chọn đúng hơn.</h2>
            <p>So sánh chi tiết màn hình, chip, camera, pin và mức giá để tìm ra chiếc điện thoại thực sự dành cho bạn.</p>
            <ul>
                <li><i class="bi bi-check2"></i> Chọn từ danh sách yêu thích của bạn</li>
                <li><i class="bi bi-check2"></i> So sánh tối đa 3 điện thoại cùng lúc</li>
            </ul>
            <a class="cmp-btn" href="@(AuthHelper.IsLoggedIn
                    ? Url.Action("SoSanh", "SanPham", new { area = "" })
                    : Url.Action("Login", "Account", new { area = "", returnUrl = Url.Action("SoSanh", "SanPham", new { area = "" }) }))">
                Bắt đầu so sánh <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        <div class="cmp-right">
            @for (int i = 0; i < capSoSanh.Count; i++)
            {
                var sp = capSoSanh[i];
                <div class="cmp-item">
                    <img src="@(sp.AnhDaiDien != null ? Url.Content("~" + sp.AnhDaiDien) : noImg2)" alt="@sp.TenSanPham"
                         onerror="this.onerror=null;this.src='@noImg2'" />
                    <div>
                        <div class="cmp-name">@sp.TenSanPham</div>
                        <div class="cmp-price">@sp.GiaThapNhat.VND()</div>
                    </div>
                </div>
                if (i == 0)
                { <div class="cmp-vs">VS</div>}
            }
            <div class="cmp-item cmp-add"><i class="bi bi-plus-circle"></i> Thêm sản phẩm</div>
        </div>
    </section>
}

@if (Model.PhuKien.Any())
{
    <section class="sec">
        <div class="sec-head">
            <h2>Sắm thêm phụ kiện chất lượng</h2>
            <div class="sec-tabs">
                <a class="all" href="@Url.Action("Index", "SanPham", new { area = "", loaiId = 3 })">Xem tất cả</a>
            </div>
        </div>
        <div class="pgrid">
            @foreach (var sp in Model.PhuKien)
            {@Html.Partial("_SanPhamCard", sp)}
        </div>
    </section>
}
@if (Model.Tin.Any() || Model.Video.Any())
{
    <section class="sec" id="tin-tuc">
        <div class="sec-head"><h2>Tin công nghệ</h2></div>
        @if (Model.Tin.Any())
        {
            <div class="news-grid">
                @foreach (var n in Model.Tin)
                {
                    <a class="news-card" href="@n.Link" target="_blank" rel="noopener">
                        <div class="news-img"><img src="@n.Image" alt="" referrerpolicy="no-referrer" loading="lazy" onerror="this.onerror=null;this.src='@noImg2'" /></div>
                        <h3>@n.Title</h3>
                        <div class="news-meta">@n.Source &middot; @n.Date.ToString("dd/MM/yyyy")</div>
                    </a>
                }
            </div>
        }
        @if (Model.Video.Any())
        {
            <div class="sec-head mt-3"><h2>Video</h2></div>
            <div class="video-grid">
                @foreach (var v in Model.Video)
                {
                    <button type="button" class="video-card" data-id="@v.Id" data-title="@v.Title">
                        <div class="video-thumb"><img src="@v.Thumb" alt="" loading="lazy" /></div>
                        <h3>@v.Title</h3>
                        <div class="news-meta">@v.Channel</div>
                    </button>
                }
            </div>

            <div class="modal fade" id="videoModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-centered">
                    <div class="modal-content bg-dark">
                        <div class="modal-header border-0">
                            <h2 class="modal-title h6 text-white" id="videoTitle"></h2>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
                        </div>
                        <div class="modal-body p-0">
                            <iframe id="videoFrame" class="video-frame" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
                        </div>
                    </div>
                </div>
            </div>
        }
    </section>
}
@section scripts {
    <script>
        $('.hrow-nav').on('click', function () {
            var row = $(this).siblings('.hrow')[0];
            row.scrollBy({ left: ($(this).hasClass('next') ? 1 : -1) * row.clientWidth * 0.8, behavior: 'smooth' });
        });

        (function () {
            var el = document.getElementById('cdDeal');
            if (!el) return;
            function p(n) { return n < 10 ? '0' + n : n; }
            function tick() {
                var now = new Date(), end = new Date(now);
                end.setHours(23, 59, 59, 999);
                var s = Math.max(0, Math.floor((end - now) / 1000));
                el.textContent = p(Math.floor(s / 3600)) + ':' + p(Math.floor((s % 3600) / 60)) + ':' + p(s % 60);
            }
            tick(); setInterval(tick, 1000);
        })();
        $('#tin-tuc .video-card[data-id]').on('click', function () {
    $('#videoTitle').text($(this).data('title'));
    $('#videoFrame').attr('src', 'https://www.youtube-nocookie.com/embed/' + $(this).data('id') + '?autoplay=1&rel=0');
    bootstrap.Modal.getOrCreateInstance(document.getElementById('videoModal')).show();
});
$('#videoModal').on('hidden.bs.modal', function () { $('#videoFrame').attr('src', ''); });
    </script>
}