@model WebsiteQuanLiDienThoaiDiDong.Areas.Admin.Controllers.ThongKeVM
@using System.Web.Helpers
@functions {
    static readonly System.Globalization.CultureInfo Vi = new System.Globalization.CultureInfo("vi-VN");
    static string Gon(decimal v)
    {
        if (v >= 1000000000m) return (v / 1000000000m).ToString("0.##", Vi) + " tỷ";
        if (v >= 1000000m) return (v / 1000000m).ToString("0.#", Vi) + " tr";
        if (v >= 1000m) return (v / 1000m).ToString("0", Vi) + "k";
        return v.ToString("0", Vi);
    }
}
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Thống kê";
    int homNay = DateTime.Now.Year;
    int tuNam = Math.Min(Model.Nam, homNay - 6), denNam = Math.Max(Model.Nam, homNay);
    int maxBan = Model.TopBanChay.Any() ? Model.TopBanChay.Max(x => x.SoLuong) : 1;
    bool coDon = Model.TrangThaiDon.Sum(x => x.SoLuong) > 0;
}

<form method="get" action="@Url.Action("Index", "ThongKe")" class="adm-toolbar">
    <div>
        <label class="form-label small mb-1">Năm thống kê</label>
        <select name="nam" class="form-select" onchange="this.form.submit()">
            @for (int y = denNam; y >= tuNam; y--)
            {
                <option value="@y" @(y == Model.Nam ? "selected" : "")>@y</option>
            }
        </select>
    </div>
    <a class="btn btn-outline-secondary ms-auto" href="@Url.Action("Index", "Kho")"><i class="bi bi-box-seam"></i> Quản lý kho</a>
</form>

<!-- KPI -->
<div class="row g-3 mb-3">
    <div class="col-sm-6 col-xl-3">
        <div class="adm-card adm-kpi">
            <div class="adm-kpi-ico red"><i class="bi bi-cash-coin"></i></div>
            <div>
                <div class="adm-kpi-label">Doanh thu năm @Model.Nam</div>
                <div class="adm-kpi-value">@Model.DoanhThuNam.VND()</div>
                <div class="adm-kpi-sub">
                    @if (Model.TangTruong.HasValue)
                    {
                        <span class="@(Model.TangTruong.Value >= 0 ? "adm-up" : "adm-down")">
                            <i class="bi @(Model.TangTruong.Value >= 0 ? "bi-arrow-up-short" : "bi-arrow-down-short")"></i>@(Math.Abs(Model.TangTruong.Value))%
                        </span> <span>so với năm @(Model.Nam - 1)</span>
                    }
                    else
                    {
                        <span>Chưa có số liệu năm @(Model.Nam - 1)</span>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="adm-card adm-kpi">
            <div class="adm-kpi-ico green"><i class="bi bi-bag-check"></i></div>
            <div>
                <div class="adm-kpi-label">Đơn hoàn tất</div>
                <div class="adm-kpi-value">@Model.SoDonHoanTat.ToString("N0")</div>
                <div class="adm-kpi-sub">Trong năm @Model.Nam</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="adm-card adm-kpi">
            <div class="adm-kpi-ico blue"><i class="bi bi-receipt-cutoff"></i></div>
            <div>
                <div class="adm-kpi-label">Giá trị đơn trung bình</div>
                <div class="adm-kpi-value">@Model.GiaTriTrungBinh.VND()</div>
                <div class="adm-kpi-sub">Doanh thu / số đơn hoàn tất</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a class="adm-card adm-kpi text-decoration-none text-reset" href="@Url.Action("Index", "DonHang", new { tt = "ChoXacNhan" })">
            <div class="adm-kpi-ico amber"><i class="bi bi-hourglass-split"></i></div>
            <div>
                <div class="adm-kpi-label">Đơn chờ xác nhận</div>
                <div class="adm-kpi-value">@Model.DonChoXacNhan</div>
                <div class="adm-kpi-sub">Bấm để xử lý</div>
            </div>
        </a>
    </div>
</div>

<!-- Biểu đồ -->
<div class="row g-3 mb-3">
    <div class="col-lg-8">
        <div class="adm-card h-100">
            <h5 class="adm-card-title">
                <span><i class="bi bi-bar-chart-line text-danger"></i> Doanh thu theo tháng</span>
                <small class="text-muted fw-normal">Bấm vào cột để xem đơn của tháng</small>
            </h5>
            <div class="adm-chart"><canvas id="chartDoanhThu"></canvas></div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="adm-card h-100">
            <h5 class="adm-card-title"><span><i class="bi bi-pie-chart text-danger"></i> Đơn hàng theo trạng thái</span></h5>
            @if (coDon)
            {
                <div class="adm-chart"><canvas id="chartTrangThai"></canvas></div>
            }
            else
            {
                <div class="adm-empty"><i class="bi bi-inbox"></i>Chưa có đơn hàng trong năm @Model.Nam.</div>
            }
        </div>
    </div>
</div>

<!-- Bán chạy + cảnh báo tồn -->
<div class="row g-3 mb-3">
    <div class="col-lg-7">
        <div class="adm-card h-100">
            <h5 class="adm-card-title"><span><i class="bi bi-trophy text-danger"></i> Sản phẩm bán chạy năm @Model.Nam</span></h5>
            @if (!Model.TopBanChay.Any())
            {
                <div class="adm-empty"><i class="bi bi-inbox"></i>Chưa có đơn hoàn tất.</div>
            }
            else
            {
                <table class="adm-table">
                    <thead><tr><th style="width:44px">#</th><th>Sản phẩm</th><th class="num">Đã bán</th><th class="num">Doanh thu</th></tr></thead>
                    <tbody>
                        @{ int hang = 0; }
                        @foreach (var t in Model.TopBanChay)
                        {
                            hang++;
                            <tr>
                                <td><strong>@hang</strong></td>
                                <td>
                                    <div class="adm-prod-name">@t.Ten</div>
                                    <div class="adm-bar"><span style="width:@((int)Math.Round(t.SoLuong * 100.0 / maxBan))%"></span></div>
                                </td>
                                <td class="num">@t.SoLuong</td>
                                <td class="num"><strong>@t.DoanhThu.VND()</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
    <div class="col-lg-5">
        <div class="adm-card h-100">
            <h5 class="adm-card-title">
                <span>
                    <i class="bi bi-exclamation-triangle text-danger"></i> Cảnh báo tồn kho
                    @if (Model.SoCanhBaoTon > 0)
                    {<span class="adm-badge adm-badge-red ms-1">@Model.SoCanhBaoTon</span>}
                </span>
                <a class="small" href="@Url.Action("Index", "Kho", new { tt = "sap" })">Xem kho</a>
            </h5>
            @if (!Model.CanhBaoTon.Any())
            {
                <div class="adm-empty"><i class="bi bi-check-circle"></i>Tồn kho ổn định.</div>
            }
            else
            {
                foreach (var c in Model.CanhBaoTon)
                {
                    var bt = string.Join(" · ", new[] { c.DungLuong, c.MauSac }.Where(s => !string.IsNullOrWhiteSpace(s)));
                    <div class="adm-stock-item">
                        <div>
                            <div class="adm-prod-name">@c.Ten</div>
                            <div class="adm-prod-sub">
                                @bt ·
                            <span class="@(c.SoLuongTon <= 0 ? "adm-out" : "text-warning")">@(c.SoLuongTon <= 0 ? "Hết hàng" : "Còn " + c.SoLuongTon)</span>
                        </div>
                    </div>
                    <a class="btn btn-sm btn-outline-success" href="@Url.Action("PhieuKho", "Kho", new { bienTheId = c.BienTheId, loai = "Nhap" })">Nhập kho</a>
                </div>
            }
        }
        </div>
    </div>
</div>

<!-- Đơn gần đây -->
<div class="adm-card mb-3">
    <h5 class="adm-card-title"><span><i class="bi bi-receipt text-danger"></i> Đơn hàng gần đây</span></h5>
    @if (!Model.DonGanDay.Any())
    {
        <div class="adm-empty"><i class="bi bi-inbox"></i>Chưa có đơn hàng.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="adm-table">
                <thead><tr><th>Mã đơn</th><th>Người nhận</th><th>Ngày đặt</th><th>Trạng thái</th><th class="num">Tổng thanh toán</th></tr></thead>
                <tbody>
                    @foreach (var d in Model.DonGanDay)
                    {
                        <tr>
                            <td><strong>@d.MaDonHang</strong></td>
                            <td>@d.TenNguoiNhan</td>
                            <td>@d.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="adm-badge adm-badge-@d.Mau">@d.TenTrangThai</span></td>
                            <td class="num"><strong>@((d.Tong ?? 0m).VND())</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Chi tiết theo tháng -->
<div class="adm-card" id="chi-tiet">
    <h5 class="adm-card-title"><span><i class="bi bi-calendar3 text-danger"></i> Chi tiết theo tháng</span></h5>
    <div class="adm-months mb-3">
        @for (int i = 0; i < 12; i++)
        {
            <a class="adm-month @(Model.Thang == i + 1 ? "active" : "")" href="@(Url.Action("Index", "ThongKe", new { nam = Model.Nam, thang = i + 1 }) + "#chi-tiet")">
                <small>Tháng @(i + 1)</small>
                <strong>@Gon(Model.DoanhThuThang[i])</strong>
                <small>@Model.SoDonThang[i] đơn</small>
            </a>
        }
    </div>

    @if (Model.Thang.HasValue)
    {
        <h6>
            Đơn hoàn tất tháng @Model.Thang/@Model.Nam
            <a class="small ms-2" href="@Url.Action("Index", "ThongKe", new { nam = Model.Nam })">Đóng</a>
        </h6>
        if (!Model.DonTrongThang.Any())
        {
            <div class="adm-empty"><i class="bi bi-inbox"></i>Không có đơn hoàn tất trong tháng này.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="adm-table">
                    <thead>
                        <tr><th>Mã đơn</th><th>Người nhận</th><th>SĐT</th><th class="num">Tiền hàng</th><th class="num">Giảm</th><th class="num">Thanh toán</th><th>Ngày giao</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.DonTrongThang)
                        {
                            <tr>
                                <td><strong>@d.MaDonHang</strong></td>
                                <td>@d.TenNguoiNhan</td>
                                <td>@d.SoDienThoai</td>
                                <td class="num">@d.TongTienHang.VND()</td>
                                <td class="num">@d.TienGiam.VND()</td>
                                <td class="num"><strong>@((d.TongThanhToan ?? 0m).VND())</strong></td>
                                <td>@(d.NgayGiaoXong.HasValue ? d.NgayGiaoXong.Value.ToString("dd/MM/yyyy") : "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else
    {
        <div class="text-muted small">Chọn một tháng để xem danh sách đơn hoàn tất.</div>
    }
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script>
    var hienTai = @Html.Raw(Json.Encode(Model.DoanhThuThang));
    var namTruoc = @Html.Raw(Json.Encode(Model.DoanhThuNamTruoc));
    var soDon = @Html.Raw(Json.Encode(Model.SoDonThang));
    var nhan = ['T1', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7', 'T8', 'T9', 'T10', 'T11', 'T12'];
    var vnd = new Intl.NumberFormat('vi-VN');
    Chart.defaults.font.family = "'Be Vietnam Pro', sans-serif";

    new Chart(document.getElementById('chartDoanhThu'), {
        type: 'bar',
        data: {
            labels: nhan,
            datasets: [
                { type: 'bar', label: 'Năm @Model.Nam', data: hienTai, backgroundColor: 'rgba(215,0,24,.85)', borderRadius: 6, order: 2 },
                { type: 'line', label: 'Năm @(Model.Nam - 1)', data: namTruoc, borderColor: '#9ca3af', borderDash: [5, 4], pointRadius: 3, tension: .3, order: 1 }
            ]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            interaction: { mode: 'index', intersect: false },
            plugins: {
                legend: { position: 'bottom' },
                tooltip: {
                    callbacks: {
                        label: function (c) { return c.dataset.label + ': ' + vnd.format(c.raw) + ' đ'; },
                        afterBody: function (items) { return items.length ? 'Số đơn hoàn tất: ' + soDon[items[0].dataIndex] : ''; }
                    }
                }
            },
            scales: {
                x: { grid: { display: false } },
                y: { beginAtZero: true, ticks: { callback: function (v) { return new Intl.NumberFormat('vi-VN', { notation: 'compact' }).format(v); } } }
            },
            onClick: function (e, els) {
                if (els.length) location.href = '@Url.Action("Index", "ThongKe", new { nam = Model.Nam })' + '&thang=' + (els[0].index + 1) + '#chi-tiet';
            }
        }
    });

    var elTT = document.getElementById('chartTrangThai');
    if (elTT) {
        new Chart(elTT, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(Json.Encode(Model.TrangThaiDon.Select(x => x.Ten).ToArray())),
                datasets: [{
                    data: @Html.Raw(Json.Encode(Model.TrangThaiDon.Select(x => x.SoLuong).ToArray())),
                    backgroundColor: ['#f59e0b', '#3b82f6', '#8b5cf6', '#16a34a', '#9ca3af'],
                    borderWidth: 2
                }]
            },
            options: { responsive: true, maintainAspectRatio: false, cutout: '62%', plugins: { legend: { position: 'bottom' } } }
        });
    }
</script>