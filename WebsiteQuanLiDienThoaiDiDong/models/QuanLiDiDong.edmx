          <EntitySet Name="vw_CanhBaoTonKho" EntityType="Self.vw_CanhBaoTonKho" store:Type="Views" store:Schema="dbo">
            <DefiningQuery>SELECT 
    [vw_CanhBaoTonKho].[BienTheId] AS [BienTheId], 
    [vw_CanhBaoTonKho].[SanPhamId] AS [SanPhamId], 
    [vw_CanhBaoTonKho].[TenSanPham] AS [TenSanPham], 
    [vw_CanhBaoTonKho].[MauSac] AS [MauSac], 
    [vw_CanhBaoTonKho].[DungLuong] AS [DungLuong], 
    [vw_CanhBaoTonKho].[SKU] AS [SKU], 
    [vw_CanhBaoTonKho].[SoLuongTon] AS [SoLuongTon], 
    [vw_CanhBaoTonKho].[NguongCanhBao] AS [NguongCanhBao]
    FROM [dbo].[vw_CanhBaoTonKho] AS [vw_CanhBaoTonKho]</DefiningQuery>
          </EntitySet>
          <EntitySet Name="vw_NguoiDaMuaSanPham" EntityType="Self.vw_NguoiDaMuaSanPham" store:Type="Views" store:Schema="dbo">
            <DefiningQuery>SELECT 
    [vw_NguoiDaMuaSanPham].[NguoiDungId] AS [NguoiDungId], 
    [vw_NguoiDaMuaSanPham].[SanPhamId] AS [SanPhamId]
    FROM [dbo].[vw_NguoiDaMuaSanPham] AS [vw_NguoiDaMuaSanPham]</DefiningQuery>
          </EntitySet>
          <EntitySet Name="vw_SanPhamHienThi" EntityType="Self.vw_SanPhamHienThi" store:Type="Views" store:Schema="dbo">
            <DefiningQuery>SELECT 
    [vw_SanPhamHienThi].[Id] AS [Id], 
    [vw_SanPhamHienThi].[TenSanPham] AS [TenSanPham], 
    [vw_SanPhamHienThi].[LoaiId] AS [LoaiId], 
